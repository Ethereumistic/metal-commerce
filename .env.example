# Public origin used for canonical and alternate-language URLs.
VITE_SITE_URL=https://echoray.cloud

# Worker bindings are configured in wrangler.jsonc. Local overrides go in .dev.vars.
# These catalog values are PUBLIC configuration, never operator credentials:
# STOREFRONT_GATEWAY_URL=https://commerce.echoray.io
# STOREFRONT_PUBLIC_INTEGRATION_ID=p1724smvytpbhadhmmdfpgh3p58fnvxe
# STOREFRONT_CATALOG_ADAPTER=gateway
# Use direct only for an explicitly selected rollback; failures never switch adapters.

# Existing protected bindings remain server-side; use wrangler secret put NAME.
# Never prefix credentials with VITE_ or commit their values.
# STOREFRONT_INTEGRATION_ID (existing registration binding, preserved)
# STOREFRONT_INTEGRATION_SECRET
# STOREFRONT_DOMAIN_CHALLENGE
