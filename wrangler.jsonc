{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moris",
  "account_id": "ccb39f37d9a46c36f7ded1cc121968a8",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "routes": [{ "pattern": "echoray.cloud", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "STOREFRONT_ORIGIN": "https://echoray.cloud",
    "STOREFRONT_CONVEX_URL": "https://convex.echoray.io",
    "STOREFRONT_CATALOG_ADAPTER": "gateway",
    "STOREFRONT_GATEWAY_URL": "https://commerce.echoray.io",
    "STOREFRONT_PUBLIC_INTEGRATION_ID": "p1724smvytpbhadhmmdfpgh3p58fnvxe",
    "STOREFRONT_AUTH_ORIGIN": "https://dev.echoray.io",
    "STOREFRONT_BUSINESS_ID": "ks78yp26ch3085wpavqdwas6gs8fkdqa",
  },
  // Isolated fixture transport for acceptance. Never deploy this environment.
  "env": {
    "catalog_test": {
      "name": "moris-catalog-test",
      "routes": [],
      "vars": {
        "STOREFRONT_ORIGIN": "https://echoray.cloud",
        "STOREFRONT_CONVEX_URL": "https://convex.echoray.io",
        "STOREFRONT_CATALOG_ADAPTER": "gateway",
        "STOREFRONT_GATEWAY_URL": "http://127.0.0.1:4319",
        "STOREFRONT_PUBLIC_INTEGRATION_ID": "p1724smvytpbhadhmmdfpgh3p58fnvxe",
        "STOREFRONT_AUTH_ORIGIN": "https://dev.echoray.io",
        "STOREFRONT_BUSINESS_ID": "ks78yp26ch3085wpavqdwas6gs8fkdqa",
      },
    },
  },
}
