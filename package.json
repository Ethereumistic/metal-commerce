{
  "name": "metal-commerce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test:locale": "node --test tests/locale.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src messages tests *.ts *.json *.jsonc README.md",
    "test:catalog": "playwright test --config playwright.catalog.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@echoray/api-client": "file:vendor/echoray-api-client-1.0.0.tgz",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "convex": "1.45.0",
    "lucide-react": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "latest",
    "tw-animate-css": "latest",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "^8.3.2",
    "wrangler": "latest"
  }
}
