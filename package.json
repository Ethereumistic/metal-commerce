{
  "name": "metal-commerce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:store": "pnpm --filter @metal/store dev",
    "dev:admin": "pnpm --filter @metal/admin dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "deploy": "turbo run deploy --concurrency=1",
    "deploy:store": "pnpm --filter @metal/store run deploy",
    "deploy:admin": "pnpm --filter @metal/admin run deploy"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "playwright": "^1.63.0"
  }
}
