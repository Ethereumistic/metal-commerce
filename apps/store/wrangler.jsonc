{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metal-craft",
  "account_id": "ccb39f37d9a46c36f7ded1cc121968a8",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "routes": [{ "pattern": "metal.echoray.cloud", "custom_domain": true }],
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "STOREFRONT_ORIGIN": "https://metal.echoray.cloud",
    "STOREFRONT_CONVEX_URL": "https://convex.echoray.io",
    "STOREFRONT_CATALOG_ADAPTER": "gateway",
    "STOREFRONT_GATEWAY_URL": "https://commerce.echoray.io",
    "STOREFRONT_PUBLIC_INTEGRATION_ID": "p172wsjnz491b5jj0cm3hh33sh8g15gp",
    "STOREFRONT_AUTH_ORIGIN": "https://dev.echoray.io",
    "STOREFRONT_BUSINESS_ID": "ks7edx6n4kr4zz1396yqy4deq18g0tkc"
  },
  // Isolated inherited fixture transport. Never deploy this environment.
  "env": {
    "catalog_test": {
      "name": "metal-craft-catalog-test",
      "routes": [],
      "vars": {
        "STOREFRONT_ORIGIN": "https://fixture.example.test",
        "STOREFRONT_CONVEX_URL": "https://convex.echoray.io",
        "STOREFRONT_CATALOG_ADAPTER": "gateway",
        "STOREFRONT_GATEWAY_URL": "http://127.0.0.1:4319",
        "STOREFRONT_PUBLIC_INTEGRATION_ID": "metalcatalogfixture00000000000001",
        "STOREFRONT_AUTH_ORIGIN": "https://dev.echoray.io",
        "STOREFRONT_BUSINESS_ID": "metal-craft-fixture-business"
      }
    }
  }
}
