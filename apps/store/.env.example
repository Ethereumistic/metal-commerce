# Canonical origin for production builds.
VITE_SITE_URL=https://metal.echoray.cloud

# Public catalog settings are in wrangler.jsonc.
# STOREFRONT_PUBLIC_INTEGRATION_ID is the Metal Craft registration ID.
# STOREFRONT_BUSINESS_ID=ks7edx6n4kr4zz1396yqy4deq18g0tkc

# Private bindings stay server-side. Use protected Cloudflare Worker secrets.
# STOREFRONT_INTEGRATION_ID
# STOREFRONT_INTEGRATION_SECRET
# STOREFRONT_DOMAIN_CHALLENGE
# Never put credentials in VITE_* or commit .dev.vars.
